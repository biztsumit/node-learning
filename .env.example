# Copy this file to .env and fill in your own values.
# .env is never committed to git; this example file is.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=postgres

# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# Razorpay (optional). Get TEST-mode keys from https://dashboard.razorpay.com → Settings → API Keys.
# The webhook secret is the one you type when adding a webhook (Settings → Webhooks).
# ⚠️ This file is committed to git: only ever put PLACEHOLDERS here. Real values go in .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# A secret YOU choose (any long random text); type the same text into Razorpay's webhook form.
# Not the webhook URL: that goes in the Razorpay dashboard, not here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (optional) for product image uploads. Free account: https://cloudinary.com/users/register_free
# All three are on the dashboard: https://console.cloudinary.com → "API Keys"
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ngrok (optional, development only): gives your local server a public https URL.
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
# Free static domain (same URL every restart): https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_DOMAIN=your-name.ngrok-free.app

# Security
# Number of proxies in front of the server (ngrok or a load balancer = 1). 0 if clients connect directly.
TRUST_PROXY=0
# Websites allowed to call the API from a browser, comma-separated (scheme + host + port, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Rate limits per client IP (these are the defaults)
API_RATE_LIMIT=120        # requests per minute
LOGIN_RATE_LIMIT=10       # failed logins / password changes per 15 minutes
SIGNUP_RATE_LIMIT=5       # sign-ups per hour

# Unpaid orders are cancelled after this many minutes and their stock released (4320 = 3 days)
ORDER_PAYMENT_TIMEOUT_MINUTES=4320
# (Checked once a minute by the "maintenance" background job)

# Public catalog reads are cached in memory for up to this long; any change clears them at once. 0 = off
CACHE_TTL_SECONDS=60

# Logging: development (pretty) | production (JSON lines) | test
NODE_ENV=development
LOG_LEVEL=info

# On a hosting platform you usually get ONE connection string instead of the DB_* settings:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to true when connecting to a hosted database from outside it (e.g. from your laptop)
# DB_SSL=true

# Emails: "log" (default) saves them as HTML files in .emails/ instead of sending.
# "brevo" sends for real: free account at https://www.brevo.com → SMTP & API → API keys,
# and verify EMAIL_FROM_ADDRESS under Senders.
EMAIL_TRANSPORT=log
# BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=orders@example.com
EMAIL_FROM_NAME=Shop
# Development / staging only: send every email to this address instead of the real recipient
# EMAIL_REDIRECT_TO=you@example.com
