// TypeScript settings. We never compile to JavaScript: Node 24 runs .ts files itself by
// stripping the types out. tsc is only the CHECKER (npm run typecheck), run in CI.
//
// The app was moved from JavaScript one layer at a time (allowJs let both live side by side).
// Now that every file is .ts, allowJs is off: a stray .js file can't slip in unchecked.
{
  "compilerOptions": {
    // Node's own module rules: ES modules, imports need their file extension
    "module": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "noEmit": true,

    // Only TypeScript syntax that can simply be erased (no enums, no namespaces, no
    // constructor parameter properties): that's what Node's type stripping understands
    "erasableSyntaxOnly": true,
    // "import type" for things that are only types, so stripping leaves no empty imports
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "allowJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // The app. The tests have their own settings (tests/tsconfig.json), checked separately.
  "include": ["src"]
}
